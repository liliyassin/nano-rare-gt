	issn = {1367-4811},
	shorttitle = {{DiSMVC}},
	url = {https://academic.oup.com/bioinformatics/article/doi/10.1093/bioinformatics/btae306/7666859},
	doi = {10.1093/bioinformatics/btae306},
	abstract = {Motivation: Exploring potential associations between diseases can help in understanding pathological mechanisms of diseases and facilitating the discovery of candidate biomarkers and drug targets, thereby promoting disease diagnosis and treatment. Some computational methods have been proposed for measuring disease similarity. However, these methods describe diseases without considering their latent multimolecule regulation and valuable supervision signal, resulting in limited biological interpretability and efficiency to capture association patterns.},
	language = {en},
	number = {5},
	urldate = {2026-06-15},
	journal = {Bioinformatics},
	author = {Wei, Hang and Gao, Lin and Wu, Shuai and Jiang, Yina and Liu, Bin},
